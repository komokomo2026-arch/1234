/** EKAMBANI POS subscription backend.
 * Subscriptions: A Device ID, B Start Days, C End Days.
 * Renewals sheet layout/data are retained; A=code, B=days, existing Status reused.
 * Deploy as Web App: Execute as Me; Who has access: Anyone.
 */
const SUBS_TAB='Subscriptions',RENEW_TAB='Renewals';
function doGet(e){const p=e&&e.parameter||{};if(p.action)return api_(p);return HtmlService.createHtmlOutputFromFile('Index').setTitle('EKAMBANI Subscription Renewal').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL)}
function api_(p){const cb=String(p.callback||'');if(!/^[A-Za-z_$][A-Za-z0-9_$]*$/.test(cb))return ContentService.createTextOutput('/* invalid callback */').setMimeType(ContentService.MimeType.JAVASCRIPT);let out;try{const id=String(p.deviceId||'').trim(),a=String(p.action||'').toLowerCase();if(a==='register')out=registerDevice_(id);else if(a==='status')out=status_(id);else if(a==='redeem')out=renewSubscription(id,String(p.renewalCode||'').trim());else out={ok:false,message:'Unknown action'}}catch(err){out={ok:false,message:err&&err.message?err.message:'Server error'}}return ContentService.createTextOutput(cb+'('+JSON.stringify(out).replace(/</g,'\\u003c')+');').setMimeType(ContentService.MimeType.JAVASCRIPT)}
function sheets_(){const ss=SpreadsheetApp.getActiveSpreadsheet();if(!ss)throw Error('Bind this Apps Script project to the subscription spreadsheet.');const s=ss.getSheetByName(SUBS_TAB),r=ss.getSheetByName(RENEW_TAB);if(!s||!r)throw Error('Required tabs Subscriptions and Renewals were not found.');const h=s.getRange(1,1,1,3).getDisplayValues()[0].map(x=>String(x).trim().toLowerCase());if(h[0]!=='device id'||h[1]!=='start days'||h[2]!=='end days')throw Error('Set Subscriptions headers exactly: Device ID | Start Days | End Days.');return{s:s,r:r}}
function lock_(){const l=LockService.getScriptLock();if(!l.tryLock(8000))throw Error('Subscription server is busy. Please retry shortly.');return l}
function findRow_(sh,col,val){const n=sh.getLastRow();if(n<2)return -1;const c=sh.getRange(2,col,n-1,1).createTextFinder(String(val)).matchEntireCell(true).matchCase(true).findNext();return c?c.getRow():-1}
function today_(){return Utilities.formatDate(new Date(),Session.getScriptTimeZone(),'yyyy-MM-dd')}
function dateString_(v){if(v instanceof Date&&!isNaN(v.getTime()))return Utilities.formatDate(v,Session.getScriptTimeZone(),'yyyy-MM-dd');const s=String(v||'').trim();return /^\d{4}-\d{2}-\d{2}$/.test(s)?s:''}
function asDate_(s){const a=s.split('-').map(Number);return new Date(a[0],a[1]-1,a[2],12,0,0)}
function plusDays_(s,n){const a=s.split('-').map(Number),d=new Date(a[0],a[1]-1,a[2],12,0,0);d.setDate(d.getDate()+n);return Utilities.formatDate(d,Session.getScriptTimeZone(),'yyyy-MM-dd')}
function registerDevice_(id){id=String(id||'').trim();if(!id||id.length>100)return{ok:false,message:'Invalid Device ID'};const l=lock_();try{const x=sheets_();let row=findRow_(x.s,1,id);if(row<0){const t=today_();row=Math.max(2,x.s.getLastRow()+1);x.s.getRange(row,1,1,3).setValues([[id,asDate_(t),asDate_(t)]]);x.s.getRange(row,2,1,2).setNumberFormat('yyyy-mm-dd');SpreadsheetApp.flush()}return statusRow_(x.s,row,id)}finally{l.releaseLock()}}
function status_(id){id=String(id||'').trim();if(!id)return{ok:false,message:'Device ID missing'};const x=sheets_(),row=findRow_(x.s,1,id);if(row<0)return{ok:false,subscriptionStatus:'unregistered',message:'Device not registered'};return statusRow_(x.s,row,id)}
function statusRow_(sh,row,id){const v=sh.getRange(row,1,1,3).getValues()[0],start=dateString_(v[1]),end=dateString_(v[2]),today=today_();const initial=!!start&&start===end,active=!!start&&!!end&&!initial&&end>=today;return{ok:true,deviceId:id,startDate:start,endDate:end,subscriptionStatus:active?'active':'expired',message:active?'Subscription active':'Subscription expired or awaiting activation'}}
function renewSubscription(id,code){id=String(id||'').trim();code=String(code||'').trim();if(!id)return{ok:false,status:false,message:'Device ID missing'};if(!code)return{ok:false,status:false,message:'Enter Renewal Code'};const l=lock_();try{const x=sheets_(),sr=findRow_(x.s,1,id);if(sr<0)return{ok:false,status:false,message:'Device ID not found in Subscriptions'};const rr=findRow_(x.r,1,code);if(rr<0)return{ok:false,status:false,message:'Invalid Renewal Code!'};const last=Math.max(2,x.r.getLastColumn()),heads=x.r.getRange(1,1,1,last).getDisplayValues()[0];let si=heads.findIndex(h=>String(h).trim()==='Status');if(si<0){si=last;x.r.getRange(1,si+1).setValue('Status')}const row=x.r.getRange(rr,1,Math.max(2,si+1)).getValues()[0];if(String(row[si]||'').trim()==='Used')return{ok:false,status:false,message:'This Renewal Code has already been used!'};const days=parseInt(row[1],10);if(!Number.isFinite(days)||days<=0)return{ok:false,status:false,message:'Renewal code has an invalid number of days'};const start=today_(),end=plusDays_(start,days);x.s.getRange(sr,2,1,2).setValues([[asDate_(start),asDate_(end)]]).setNumberFormat('yyyy-mm-dd');x.r.getRange(rr,si+1).setValue('Used').setFontColor('white').setBackground('red');SpreadsheetApp.flush();return{ok:true,status:true,deviceId:id,startDate:start,endDate:end,subscriptionStatus:'active',message:'Subscription renewed successfully!\nStart: '+start+'\nEnd: '+end}}finally{l.releaseLock()}}
function registerDeviceForHtml(id){return registerDevice_(id)}
function testSubscriptionSetup(){const x=sheets_();return{subscriptions:x.s.getName(),renewals:x.r.getName(),headers:x.s.getRange(1,1,1,3).getDisplayValues()[0]}}
